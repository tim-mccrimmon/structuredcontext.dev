---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import StarCTA from '../components/StarCTA.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<BaseLayout
	title="Structured Context Specification"
	description="SCS is an open specification for the guidance, guardrails, and facts an organization wants its AI to work from. AI drafts and maintains it through Agent Skills; a named person releases every version."
>
	<Nav />

	<!-- Hero -->
	<section class="hero">
		<p class="hero-eyebrow">Open Specification · Apache 2.0 · v0.7.0</p>
		<h1>Use AI to create and manage guidance for AI</h1>
		<p class="hero-subhead">
			SCS is an open standard for the rules and facts your organization wants its AI to work from.
			An AI assistant drafts and maintains them with you. A named person releases every version.
		</p>
		<div class="hero-ctas">
			<a href="/docs/getting-started/quick-start" class="btn btn-primary">Get Started</a>
			<a
				href="https://github.com/tim-mccrimmon/structured-context-spec"
				class="btn btn-secondary"
				target="_blank"
				rel="noopener"
			>
				Star on GitHub
			</a>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- The Problem -->
	<section class="section">
		<p class="section-label">The problem</p>
		<h2>Without written guidance, AI will assume, often wrongly</h2>
		<p class="section-intro">AI is like a capable new hire on every task: it doesn't know your rules unless someone tells it. Unlike a new hire, it rarely stops to ask.</p>
		<ul class="problem-list">
			<li>A wrong assumption reads just like a right one, so it's hard to spot</li>
			<li>Each agent has been told something different, or nothing at all, so people on the same project get different answers</li>
			<li>The unwritten rules people rely on never reach the AI</li>
			<li>When something goes wrong, there's often no clear answer to which rules applied</li>
		</ul>
	</section>

	<hr class="section-divider" />

	<!-- Guardrails vs state data -->
	<section class="section">
		<p class="section-label">What SCS covers</p>
		<h2>It's all context, but not all context is the same</h2>
		<div style="overflow-x: auto; margin-top: 1.5rem;">
			<table class="comparison-table">
				<thead>
					<tr>
						<th></th>
						<th>Guardrails (SCS)</th>
						<th>State data</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>What it is</td>
						<td>Guidance, rules, and supporting facts</td>
						<td>Current data: a record, an order, a document</td>
					</tr>
					<tr>
						<td>How it changes</td>
						<td>Rarely and deliberately, by a new version</td>
						<td>Frequently</td>
					</tr>
					<tr>
						<td>How AI gets it</td>
						<td>Supplied up front, with every request</td>
						<td>Looked up when needed, for example with retrieval</td>
					</tr>
					<tr>
						<td>Accountability</td>
						<td>A named approver</td>
						<td>The source system</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="section-intro" style="margin-top: 1.5rem;">Retrieval handles data that changes often. SCS handles the rules that should be the same from one question to the next. They work together.</p>
	</section>

	<hr class="section-divider" />

	<!-- How it works -->
	<section class="section">
		<p class="section-label">How it works</p>
		<h2>Your rules, approved, in one small file</h2>
		<div class="card-grid" style="margin-top: 1.5rem;">
			<div class="card">
				<h3>Two levels</h3>
				<p>A <strong>Domain</strong> holds the rules for all of your organization's work. A <strong>Project</strong> holds the rules for one piece of work. Projects can add rules but never loosen the Domain's.</p>
			</div>
			<div class="card">
				<h3>A person releases</h3>
				<p>Long policies are distilled into prohibitions, directives, and facts. Each section names the role accountable for it. A named person releases each version as a git tag with a content digest.</p>
			</div>
			<div class="card">
				<h3>One file for the AI</h3>
				<p>Each version compiles to a small, deterministic file. Every rule has a stable ID, so an agent can name the rule it applied.</p>
			</div>
		</div>
		<p style="margin-top: 1.5rem;">
			<a href="/docs/specification/overview" class="card-link">Read the specification overview &rarr;</a>
		</p>
	</section>

	<hr class="section-divider" />

	<!-- Skills -->
	<section class="section">
		<p class="section-label">New in SCS 0.7.0</p>
		<h2>Four skills cover every step</h2>
		<p class="section-intro">Writing and maintaining these rules by hand was the hard part. In 0.7.0, four Agent Skills take you from interview to a compiled version through conversation. You don't need to learn the spec first.</p>
		<div style="overflow-x: auto; margin-top: 1.5rem;">
			<table class="comparison-table">
				<thead>
					<tr>
						<th>Skill</th>
						<th>What it does for you</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td><code>scs-domain</code></td>
						<td>Sets up and maintains the rules for all of your organization's work, from interview to publish</td>
					</tr>
					<tr>
						<td><code>scs-project</code></td>
						<td>Adds rules for one piece of work, building on the Domain's</td>
					</tr>
					<tr>
						<td><code>scs-validate</code></td>
						<td>Runs the checks, explains the results, and proposes fixes</td>
					</tr>
					<tr>
						<td><code>scs-explain</code></td>
						<td>Explains any rule, where it came from, or a message, and writes a review package for reviewers</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="section-intro" style="margin-top: 1.5rem;">The skills show each proposed change and wait for a yes before making it. They never choose who releases a version. They use the open Agent Skills format and have been tried in Claude Code and Claude.</p>
		<p style="margin-top: 1rem;">
			<a href="/skills" class="card-link">About the skills &rarr;</a>
		</p>
	</section>

	<hr class="section-divider" />

	<!-- Audit trail -->
	<section class="section">
		<p class="section-label">Audit trail and provenance</p>
		<h2>Know which rules applied, and why</h2>
		<p class="section-intro">The record lives in the same plain files as the rules, in your own git repository.</p>
		<ul class="problem-list">
			<li><strong>Who wrote it, and why:</strong> every SCD and bundle records its author and rationale</li>
			<li><strong>Who owns it:</strong> every section names the role accountable for it, mapped to a person</li>
			<li><strong>Who released it:</strong> every version names a person, never the AI</li>
			<li><strong>What reviewers saw:</strong> a review package shows every rule word for word, with the line the AI receives</li>
			<li><strong>Where it came from:</strong> rules trace back to the source documents and intake answers they were drafted from</li>
			<li><strong>That nothing changed since:</strong> each version carries a content digest, so a later edit is detected. A formal approval in your own system can cite the same digest, which the compiled artifact also carries</li>
			<li><strong>What changed:</strong> the tools summarize the differences between any two versions</li>
		</ul>
	</section>

	<hr class="section-divider" />

	<!-- Ontologies -->
	<section class="section">
		<p class="section-label">Domain Ontology</p>
		<h2>Start from your industry, not a blank page</h2>
		<p class="section-intro">Each ontology lists what an industry needs guardrails for. You fill it in with your own decisions.</p>
		<div class="card-grid" style="margin-top: 1.5rem;">
			<div class="card">
				<h3>SDLC</h3>
				<p>Software development</p>
			</div>
			<div class="card">
				<h3>CDMO</h3>
				<p>Medical-device contract design and manufacturing</p>
			</div>
			<div class="card">
				<h3>MCA</h3>
				<p>Merchant cash advance and business funding</p>
			</div>
			<div class="card">
				<h3>Personal</h3>
				<p>One person's own guidance. New in 0.7.0.</p>
			</div>
		</div>
		<p style="margin-top: 1.5rem;">
			<a href="/docs/specification/domain-ontology" class="card-link">Read about the Domain Ontology &rarr;</a>
		</p>
	</section>

	<hr class="section-divider" />

	<!-- Standards & compliance -->
	<section class="section">
		<p class="section-label">For regulated industries</p>
		<h2>Cite the standard. Keep your own interpretation.</h2>
		<p class="section-intro">The text of most standards is licensed to the adopter, and the authoritative interpretation is your own quality system. So SCS holds your rules and cites the clause each one addresses, for example <code>std:iso-13485:2016#7.3.9</code>, without reproducing the standard.</p>
		<div class="standards-grid">
			<div class="standard-item">
				<p class="standard-name">Citations</p>
				<p class="standard-desc">Rules, facts, and ontology concepts can cite a standard, edition, and clause. Citing a clause records intent. It isn't a claim of compliance.</p>
				<a href="/docs/specification/citations" class="card-link">How citations work &rarr;</a>
			</div>
			<div class="standard-item">
				<p class="standard-name">Medical-device CDMO</p>
				<p class="standard-desc">A worked example of Domain and Project governance for a manufacturer working under ISO 13485.</p>
				<a href="/docs/examples/medtech-cdmo" class="card-link">See the example &rarr;</a>
			</div>
			<div class="standard-item">
				<p class="standard-name">Prior authorization AI</p>
				<p class="standard-desc">What changes when a coding agent has the compliance framework in its context before it writes criteria-matching logic.</p>
				<a href="/blog/compliance-framework-coding-agent" class="card-link">Read the article &rarr;</a>
			</div>
			<div class="standard-item">
				<p class="standard-name">Standards bodies</p>
				<p class="standard-desc">Ontologies can map concepts to your clauses, and rules can cite them directly, without reproducing licensed text.</p>
				<a href="mailto:info@ohana-tech.com" class="card-link">Get in touch &rarr;</a>
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- Placement -->
	<section class="section">
		<p class="section-label">Not tied to one AI service</p>
		<h2>Use the same approved rules wherever your teams work</h2>
		<p class="section-intro">A compiled artifact is plain YAML. The placement guide describes where to put the Domain and Project artifacts in Claude, Claude Code, ChatGPT Enterprise, GitHub Copilot, and Cursor. AI services treat these files as context, not enforcement, so SCS gives you a clear record of what was approved and supplied, not a guarantee of model behavior.</p>
		<p style="margin-top: 1.5rem;">
			<a href="/docs/getting-started/placement" class="card-link">Read the placement guide &rarr;</a>
		</p>
	</section>

	<hr class="section-divider" />

	<!-- Recent blog posts -->
	{recentPosts.length > 0 && (
		<section class="section">
			<p class="section-label">From the blog</p>
			<h2>On context engineering</h2>
			<div class="recent-posts" style="margin-top: 1.5rem;">
				{recentPosts.map(post => (
					<div class="recent-post">
						<a href={`/blog/${post.id}`} class="recent-post-inner">
							{post.data.image && (
								<img
									src={post.data.image}
									alt={post.data.imageAlt ?? ''}
									class="recent-post-thumb"
								/>
							)}
							<div>
								<h3>{post.data.title}</h3>
								<span class="meta">
									{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
								</span>
								<p>{post.data.description}</p>
							</div>
						</a>
					</div>
				))}
			</div>
			<p style="margin-top: 1.5rem;">
				<a href="/blog">All articles &rarr;</a>
			</p>
		</section>
	)}

	{recentPosts.length > 0 && <hr class="section-divider" />}

	<!-- Docs quick access -->
	<section class="section">
		<p class="section-label">Documentation</p>
		<h2>Reference and guides</h2>
		<div class="docs-links" style="margin-top: 1.5rem;">
			<a href="/docs/getting-started/quick-start" class="docs-link">
				Quick Start
				<span>Install the tools and skills</span>
			</a>
			<a href="/docs/skills/overview" class="docs-link">
				Agent Skills
				<span>The four skills and their rules</span>
			</a>
			<a href="/docs/specification/overview" class="docs-link">
				Specification
				<span>Bundles, SCDs, versions, artifacts</span>
			</a>
			<a href="/docs/examples/personal-domain" class="docs-link">
				Examples
				<span>Personal, organization, and CDMO</span>
			</a>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- Footer star CTA -->
	<section class="section" style="padding-top: 3rem; padding-bottom: 3rem;">
		<StarCTA />
	</section>

	<SiteFooter />
</BaseLayout>
